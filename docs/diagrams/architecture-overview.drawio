          <mxGeometry x="1200" y="70" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Investigation Reports (S3)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="opsAccount">
          <mxGeometry x="1200" y="250" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- Operator actor -->
        <mxCell id="operator" value="Operator in IDE (Kiro)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="460" y="1130" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Solid arrows: event / control flow&#10;Dashed arrows: read-only investigation access or fault injection&#10;&#9312; &#9313; &#9314;: incident escalation order&#10;&#10;Protocol: BOTH agent-to-agent links are registered over MCP (mcpserversigv4) —&#10;space-to-space uses SigV4 service ‘aidevops’ + an X-Agent-Space-Id routing header,&#10;the fallback agents use SigV4 service ‘bedrock-agentcore’ and a single ‘investigate’ tool.&#10;The agents can also serve A2A (:9000) and A2A registration scripts are retained,&#10;but A2A has not been exercised on this deployment." style="text;html=1;fontSize=11;fontColor=#5A6B86;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1080" width="400" height="150" as="geometry" />
        </mxCell>

        <!-- AWS services used — high-level estate overview -->
        <mxCell id="svcPanel" value="AWS services used in this architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#232F3E;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="620" y="1080" width="940" height="150" as="geometry" />
        </mxCell>
        <mxCell id="svcCol1" value="Compute, delivery, connectivity&#10;• Amazon ECS on AWS Fargate + Amazon ECR&#10;• AWS Lambda&#10;• Application Load Balancer + Amazon CloudFront&#10;• AWS PrivateLink (VPC endpoint service, FE &#8594; BE)&#10;• Amazon API Gateway (status-updater facade)" style="text;html=1;fontSize=11;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="svcPanel">
          <mxGeometry x="10" y="26" width="300" height="118" as="geometry" />
        </mxCell>
        <mxCell id="svcCol2" value="Data, messaging, configuration&#10;• Amazon DynamoDB&#10;• Amazon Aurora PostgreSQL&#10;• Amazon SQS &#183; Amazon SNS&#10;• Amazon S3 (KB corpus, investigation reports)&#10;• SSM Parameter Store &#183; AWS Secrets Manager" style="text;html=1;fontSize=11;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="svcPanel">
          <mxGeometry x="320" y="26" width="300" height="118" as="geometry" />
        </mxCell>
        <mxCell id="svcCol3" value="Observability, agents, chaos, identity&#10;• Amazon CloudWatch: alarms, Logs, Synthetics&#10;&#160;&#160;canary, Application Signals&#10;• AWS FIS (fault injection)&#10;• Amazon Bedrock: AgentCore Runtime, Knowledge&#10;&#160;&#160;Base, foundation models&#10;• AWS DevOps Agent (Agent Spaces)&#10;• IAM / STS cross-account roles" style="text;html=1;fontSize=11;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="svcPanel">
          <mxGeometry x="630" y="26" width="300" height="118" as="geometry" />
